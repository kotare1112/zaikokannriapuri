{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/zaiko-inventory/browser",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://zaikokannriapuri-d3a2a.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://zaikokannriapuri-d3a2a.firebaseapp.com/__/firebase/:path*"
    }
  ],
  "functions": {
    "api/yahoo-item-search.ts": {
      "maxDuration": 10,
      "regions": ["hnd1"]
    },
    "api/yahoo-furigana.ts": {
      "maxDuration": 10,
      "regions": ["hnd1"]
    }
  }
}
