rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isDeveloper() {
      // 管理者は Firebase Authentication の固有 UID でも固定する。
      // メール確認済みクレームの反映待ち中でも、管理者本人だけが
      // 申請一覧を確認・承認できるようにする。
      return request.auth != null
        && (
          request.auth.uid == 'QKWvsYuOarcMeN55ujyna2vGLHo1'
          || (
            isSignedIn()
            && request.auth.token.email == 'kotare1112@gmail.com'
          )
        );
    }

    function hasApprovedAccess() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/accessRequests/$(request.auth.uid))
        && get(/databases/$(database)/documents/accessRequests/$(request.auth.uid)).data.status == 'approved';
    }

    function canUseInventory() {
      return isDeveloper() || hasApprovedAccess();
    }

    match /accessRequests/{uid} {
      allow get: if isDeveloper() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isDeveloper();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'status', 'requestedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';
      allow update, delete: if isDeveloper();

      // 却下済みの本人だけは、Google で再ログインしたときに
      // 申請を「pending」へ戻して再申請できる。
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && resource.data.status == 'rejected'
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'status', 'requestedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'status', 'requestedAt', 'reviewedAt', 'reviewedBy'
        ]);
    }

    match /inventoryItems/{barcode} {
      allow read: if canUseInventory();
      allow create, update: if canUseInventory()
        && request.resource.data.barcode == barcode;
      allow delete: if canUseInventory();
    }

    match /productMasters/{barcode} {
      allow read: if canUseInventory();
      allow create: if canUseInventory()
        && request.resource.data.keys().hasOnly([
          'barcode', 'name', 'imageUrl', 'productUrl', 'source',
          'brand', 'storeName', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'barcode', 'name', 'imageUrl', 'productUrl', 'source',
          'brand', 'storeName', 'createdAt'
        ])
        && request.resource.data.barcode == barcode
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.source in ['manual', 'yahoo-shopping'];
      // 在庫から削除しても、登録済みの商品情報は残す。
      allow update, delete: if false;
    }
  }
}
